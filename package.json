{
  "name": "linkdrop-monorepo",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev:web": "pnpm --filter @linkdrop/web dev",
    "dev:signaling": "pnpm --filter @linkdrop/signaling dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.1.1",
    "@linkdrop/config": "workspace:*",
    "@linkdrop/protocol": "workspace:*",
    "@linkdrop/shared": "workspace:*",
    "@linkdrop/signaling": "workspace:*",
    "@linkdrop/web": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.1.1",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.2.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.4.5",
    "typescript-eslint": "^7.7.1",
    "vitest": "^1.6.0",
    "ws": "^8.21.3"
  }
}
