{
  "name": "linkdrop-monorepo",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev:web": "corepack pnpm --filter @linkdrop/web dev",
    "dev:signaling": "corepack pnpm --filter @linkdrop/signaling dev",
    "build": "corepack pnpm -r build",
    "typecheck": "corepack pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\""
  },
  "devDependencies": {
    "@linkdrop/config": "workspace:*",
    "@linkdrop/protocol": "workspace:*",
    "@linkdrop/shared": "workspace:*",
    "@linkdrop/signaling": "workspace:*",
    "@linkdrop/web": "workspace:*",
    "typescript": "^5.4.5",
    "prettier": "^3.2.5",
    "vitest": "^1.6.0",
    "eslint": "^9.1.1",
    "@eslint/js": "^9.1.1",
    "typescript-eslint": "^7.7.1",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0"
  }
}
