# LinkDrop Ephemeral Environment Templates

# Network & Signaling settings
PORT=3000
SIGNALING_PORT=3000
PUBLIC_BASE_URL=http://localhost:5173

# Redis Ephemeral Store Configuration
REDIS_URL=redis://localhost:6379

# TURN Relay Configuration (Infrastructure)
TURN_URL=turn:relay.linkdrop.app:3478
TURN_USERNAME=linkdrop-user
TURN_CREDENTIAL=temp-turn-secret-key
TURN_SECRET=issuer-secret-token

# Rate Limit Configs
RATE_LIMIT_SESSION_CREATE=10/hour
RATE_LIMIT_JOIN=20/10min
